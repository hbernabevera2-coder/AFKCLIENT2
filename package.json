{
  "name": "minecraft-afk-client",
  "version": "1.0.0",
  "author": "BernaV2",
  "description": "AFK Manager Pro",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.Alting Client.afkmanager",
    "productName": "AFK Manager Pro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/.cache",
      "!dist",
      "!msa-profiles"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^41.0.3",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "canvas": "^3.2.2",
    "discord.js": "^14.26.2",
    "express": "^5.2.1",
    "mineflayer": "^4.35.0",
    "msal-node": "^0.0.1-security",
    "open": "^11.0.0",
    "prismarine-auth": "^2.7.0",
    "prismarine-viewer": "^1.33.0",
    "proxy-agent": "^6.3.0",
    "socket.io": "^4.8.3",
    "systeminformation": "^5.25.11"
  }
}
